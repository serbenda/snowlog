{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowlog",
  "version": "0.2.0",
  "identifier": "dev.bendi.snowlog",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Snowlog",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Cuaderno de notas cifrado",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
