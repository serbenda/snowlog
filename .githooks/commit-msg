#!/bin/sh
# Quita del mensaje cualquier atribución a herramientas de IA.
# Activar una vez por clon: git config core.hooksPath .githooks
msg="$1"
tmp="$(mktemp)"
grep -viE '^(co-authored-by:.*(claude|anthropic|noreply@anthropic\.com)|claude-session:|.*generated with \[?claude)' "$msg" > "$tmp"
# Quita líneas en blanco sobrantes al final
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg"
rm -f "$tmp"
