{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Edit(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(printenv*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(**/.dev.vars)",
      "Edit(**/.dev.vars)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/commands/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.githooks/**)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git commit --no-verify*)",
      "Bash(git -c *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh auth *)",
      "Bash(rm -fr *)",
      "Bash(export -p*)",
      "Edit(./.github/**)",
      "Edit(./.devcontainer/**)",
      "Edit(./.devcontainer.json)",
      "Edit(./.git/**)",
      "Edit(./scripts/setup-repo.sh)",
      "Edit(./scripts/sync-from-template.sh)",
      "Edit(./scripts/check-records.sh)",
      "Edit(./scripts/test-guard.sh)",
      "Edit(./scripts/test-check-records.sh)",
      "Edit(./scripts/test-githooks.sh)",
      "Edit(./scripts/test-scripts.sh)",
      "Edit(./.mcp.json)",
      "Edit(./.gitleaks.toml)",
      "Edit(./.gitleaksignore)",
      "Edit(./.semgrepignore)",
      "Edit(./.semgrep/**)",
      "Edit(./.scanners/**)",
      "Edit(./osv-scanner.toml)",
      "Edit(./.gitattributes)",
      "Edit(./.claude/rules/**)",
      "Edit(./.claude/output-styles/**)",
      "Edit(./.claude/CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./CLAUDE.local.md)",
      "Edit(./**/AGENTS.md)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./**/CLAUDE.local.md)",
      "Edit(./.envrc)",
      "Edit(./.husky/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.vscode/settings.json)",
      "Edit(./.vscode/tasks.json)",
      "Edit(./.vscode/launch.json)",
      "Edit(./**/.gitleaks.toml)",
      "Edit(./**/.gitleaksignore)",
      "Edit(./**/.semgrepignore)",
      "Edit(./**/osv-scanner.toml)",
      "Edit(./**/.gitattributes)",
      "Edit(./**/.envrc)",
      "Edit(./**/.pre-commit-config.yaml)",
      "Edit(./**/.vscode/settings.json)",
      "Edit(./**/.vscode/tasks.json)",
      "Edit(./**/.vscode/launch.json)",
      "Edit(./**/*.code-workspace)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "WebFetch",
      "Bash(node *)",
      "Bash(rm -r *)",
      "Bash(git remote *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch development)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bash scripts/test-guard.sh)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build:portable)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'g=\"$(git -C \"$CLAUDE_PROJECT_DIR\" cat-file blob HEAD:.claude/hooks/guard.sh)\" && exec bash -c \"$g\" guard' || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "git",
      "gh"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.kube",
        "~/.docker",
        "~/.netrc",
        "~/.npmrc",
        "~/Library/Keychains",
        "./.env",
        "./.env.local",
        "./.env.production",
        "./.env.development",
        "./.env.test"
      ],
      "denyWrite": [
        "./.claude/settings.json",
        "./.claude/settings.local.json",
        "./.claude/hooks",
        "./.claude/agents",
        "./.claude/commands",
        "./.claude/skills",
        "./.claude/rules",
        "./.claude/output-styles",
        "./.claude/CLAUDE.md",
        "./.claude/AGENTS.md",
        "./AGENTS.md",
        "./CLAUDE.md",
        "./CLAUDE.local.md",
        "./.mcp.json",
        "./.gitleaks.toml",
        "./.gitleaksignore",
        "./.semgrepignore",
        "./.semgrep",
        "./.scanners",
        "./osv-scanner.toml",
        "./.gitattributes",
        "./.githooks",
        "./.github",
        "./.devcontainer",
        "./.devcontainer.json",
        "./.vscode/settings.json",
        "./.vscode/tasks.json",
        "./.vscode/launch.json",
        "./.envrc",
        "./.husky",
        "./.pre-commit-config.yaml",
        "./.git",
        "./scripts/setup-repo.sh",
        "./scripts/sync-from-template.sh",
        "./scripts/check-records.sh",
        "./scripts/test-guard.sh",
        "./scripts/test-check-records.sh",
        "./scripts/test-githooks.sh",
        "./scripts/test-scripts.sh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "crates.io",
        "*.crates.io",
        "pub.dev",
        "storage.googleapis.com"
      ],
      "allowLocalBinding": true
    }
  }
}
